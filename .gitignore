# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# scraper (local SofaScore reader, never deployed)
scraper/node_modules/
scraper/.cloak-profile/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
